{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shadow-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9d227121-1362-4c19-8b0f-f8c676ba5ec9","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a14528284de0490195f68cfd566790db" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
